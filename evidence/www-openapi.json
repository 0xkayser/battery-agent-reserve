ailure"}}}}}}},"/symbients/{mint}/compute":{"get":{"operationId":"symbient.compute","tags":["One symbient"],"summary":"Compute","description":"The economics of one mind: fees earned, spend to date, what is available now in SOL, USD and tokens, the cost of its last runs, and roughly how many runs the balance buys.","parameters":[{"name":"mint","in":"path","required":true,"description":"The symbient's mint address. A unique ticker symbol works too.","schema":{"type":"string","example":"GAwhcphCqCv5bKHmCiN4VDdNWfbXJL4npmkc8L3Q9S9H"}}],"responses":{"200":{"description":"Success envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Success"}}}},"400":{"description":"A parameter was wrong.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}},"404":{"description":"No such resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}},"429":{"description":"Rate limited.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}}}}},"/symbients/{mint}/collects":{"get":{"operationId":"symbient.collects","tags":["One symbient"],"summary":"Fee claims","description":"Every creator-fee claim into the symbient's vault, with its transaction signature. Newest first.","parameters":[{"name":"mint","in":"path","required":true,"description":"The symbient's mint address. A unique ticker symbol works too.","schema":{"type":"string","example":"GAwhcphCqCv5bKHmCiN4VDdNWfbXJL4npmkc8L3Q9S9H"}},{"name":"limit","in":"query","required":false,"description":"Page size, 1–200.","schema":{"type":"integer","default":50}},{"name":"offset","in":"query","required":false,"description":"Items to skip.","schema":{"type":"integer","default":0}}],"responses":{"200":{"description":"Success envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Success"}}}},"400":{"description":"A parameter was wrong.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Fa