Failure"}}}}}}},"/models/{id}":{"get":{"operationId":"model.get","tags":["Catalog"],"summary":"Get a model","description":"One model with its prices and every symbient that thinks with it.","parameters":[{"name":"id","in":"path","required":true,"description":"OpenRouter model id, with the slash.","schema":{"type":"string","example":"anthropic/claude-opus-5.5"}}],"responses":{"200":{"description":"Success envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Success"}}}},"400":{"description":"A parameter was wrong.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}},"404":{"description":"No such resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}},"429":{"description":"Rate limited.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}}}}},"/labs":{"get":{"operationId":"labs","tags":["Catalog"],"summary":"Labs","description":"The labs behind the models, with their mark, colour, model count, and how many symbients and how much compute each commands.","parameters":[],"responses":{"200":{"description":"Success envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Success"}}}},"400":{"description":"A parameter was wrong.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}},"404":{"description":"No such resource.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}},"429":{"description":"Rate limited.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Failure"}}}}}}},"/personas":{"get":{"operationId":"personas","tags":["Catalog"],"summary":"Themes","description":"The themes a mind can be launched with: what each is curious about and where it starts reading, with how many symbients have chosen each.","parameters":[],"responses":{"200":{"description":"Success envelope.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Su